<div id="vcomments"></div>
<script src="https://cdn.jsdelivr.net/npm/valine@1.4.18/dist/Valine.min.js"></script>
<script>
  new Valine({
    el: '#vcomments',
    appId: '<%= site.customConfig.valineAppId %>',
    appKey: '<%= site.customConfig.valineAppKey %>',
    placeholder: '<%= site.customConfig.valinePlaceholder || "说点什么吧..." %>',
    avatar: '<%= site.customConfig.valineAvatar || "mp" %>',
    meta: ['nick', 'mail', 'link'],
    pageSize: <%= site.customConfig.valinePageSize || 10 %>,
    lang: '<%= site.customConfig.valineLang || "zh-CN" %>',
    recordIP: <%= site.customConfig.valineRecordIP || false %>,
    enableQQ: <%= site.customConfig.valineEnableQQ || false %>
  })
</script>
